<Window x:Class="KeyboardSound.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Keyboard Sound" Width="1120" Height="780" MinWidth="960" MinHeight="700" Background="#0C1423" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
 <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><StackPanel><TextBlock Text="KEYBOARD SOUND" FontSize="28" FontWeight="Bold"/><TextBlock Text="Make every key your own." Margin="0,6,0,18" Foreground="#94A8C5"/></StackPanel><CheckBox x:Name="EnabledBox" Content="Global sounds enabled" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="OptionsChanged" Unchecked="OptionsChanged"/></Grid>
  <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="12" Padding="12" Margin="0,0,0,16"><DockPanel><TextBlock Text="PROFILE" VerticalAlignment="Center" Margin="8"/><ComboBox x:Name="ProfileBox" Width="210" SelectionChanged="ProfileChanged"/><TextBox x:Name="ProfileName" Width="170" ToolTip="Profile name"/><Button Content="New / Clone" Click="CloneProfile"/><Button Content="Rename" Click="RenameProfile"/><Button Content="Delete" Click="DeleteProfile"/><TextBlock/></DockPanel></Border>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="275"/></Grid.ColumnDefinitions>
   <Border Background="{StaticResource Panel}" CornerRadius="12" Padding="16" Margin="0,0,16,0"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="YOUR KEYBOARD" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Select a key, then assign a sound. Blue keys have a mapping." Margin="0,8,0,18" Foreground="#94A8C5"/><StackPanel x:Name="KeyboardPanel"/><TextBlock Text="Includes function keys, modifiers, arrows and number pad." Margin="0,18,0,8" Foreground="#94A8C5"/><TextBox Height="80" AcceptsReturn="True" TextWrapping="Wrap" ToolTip="Try typing here"/><TextBlock Text="Typing playground — this text is never saved." Foreground="#94A8C5" Margin="4"/></StackPanel></ScrollViewer></Border>
   <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="12" Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock x:Name="SelectedLabel" Text="Key: A" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="SOUND LIBRARY" Margin="0,22,0,8" Foreground="#94A8C5"/><ComboBox x:Name="SoundBox"/><Button Content="Import MP3 / WAV" Click="ImportSound"/><Button Content="Assign to selected key" Click="AssignSound"/><Button Content="Preview sound" Click="PreviewSound"/><Button Content="Clear key mapping" Click="ClearMapping"/><Button Content="Delete sound from library" Click="DeleteSound"/><TextBlock x:Name="MappingLabel" TextWrapping="Wrap" Margin="4,14"/><TextBlock Text="Up to 15 seconds / 20 MB per file. Imported files are copied into your library." TextWrapping="Wrap" Foreground="#94A8C5" Margin="4"/></StackPanel></ScrollViewer></Border>
  </Grid>
  <Border Grid.Row="3" Background="{StaticResource Panel}" CornerRadius="12" Padding="12" Margin="0,16,0,0"><StackPanel><DockPanel><TextBlock Text="VOLUME" VerticalAlignment="Center" Margin="8"/><Slider x:Name="VolumeSlider" Width="180" Minimum="0" Maximum="100" ValueChanged="VolumeChanged" VerticalAlignment="Center"/><CheckBox x:Name="RepeatBox" Content="Repeat held keys" Checked="OptionsChanged" Unchecked="OptionsChanged"/><CheckBox x:Name="StartupBox" Content="Start with Windows" Click="StartupChanged"/><Button Content="Hide to tray" Click="HideToTray"/><TextBlock/></DockPanel><TextBlock x:Name="Status" Text="Ready" Margin="8" TextWrapping="Wrap" Foreground="#A7C8F0"/></StackPanel></Border>
 </Grid>
</Window>

